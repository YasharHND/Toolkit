{
  "name": "toolkit",
  "version": "1.0.0",
  "private": true,
  "description": "Toolkit monorepo with React frontend and CDK infrastructure",
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter app dev",
    "build": "pnpm --filter app build",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "type:check": "tsc -b --noEmit",
    "lint:check": "eslint .",
    "lint:fix": "eslint --fix .",
    "prepare": "husky",
    "infra": "cdk",
    "infra:synth": "cdk synth",
    "infra:deploy": "cdk deploy --require-approval never",
    "infra:destroy": "cdk destroy",
    "infra:diff": "cdk diff"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.253.1",
    "constructs": "^10.6.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.6.2",
    "aws-cdk": "^2.1121.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.2"
  }
}
